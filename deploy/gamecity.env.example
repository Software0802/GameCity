# /opt/gamecity/.env — runtime settings read by gamecity.service (EnvironmentFile).
# Install as root:gamecity 0640. Changing a value needs `systemctl restart gamecity`,
# which is a production change: owner confirmation first (docs/ops/deploy.md).

# ENet listens on UDP; the security group must allow UDP, not TCP, on this port.
GAMECITY_PORT=24567
# Sim pace: 1.0 for a real round, 0.01 for a test round.
GAMECITY_PACE=1.0
# Wall-clock round length. 604800 = 7 days (SliceConstants.ROUND_SECONDS_DEFAULT).
GAMECITY_ROUND_SECONDS=604800
# Seconds between snapshots under data/.
GAMECITY_SAVE_INTERVAL=30
