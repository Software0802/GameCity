# deploy/.env — settings for deploy/deploy.sh. Copy to deploy/.env (git-ignored) and fill in.
# The host address never goes into the repository; the owner hands it over out of band.

# Required: where to deploy.
GAMECITY_HOST=
GAMECITY_SSH_USER=

# Optional, defaults shown.
GAMECITY_SSH_PORT=22
# Extra ssh/scp options, e.g. "-i ~/.ssh/gamecity_ed25519 -o ProxyJump=bastion".
GAMECITY_SSH_OPTS=
# Remote tree (docs/ops/deploy.md). godot binary, releases/, current, data/, backups/, .env live under it.
GAMECITY_REMOTE_ROOT=/opt/gamecity
# systemd unit and the account that runs it.
GAMECITY_SERVICE=gamecity
GAMECITY_RUN_USER=gamecity
GAMECITY_RUN_GROUP=gamecity
# "sudo" when the ssh user is not root; empty when it is.
GAMECITY_SUDO=sudo
# Releases to keep under releases/ after a successful switch.
GAMECITY_KEEP_RELEASES=3
# Seconds to wait for status.json to report healthy (mtime <= 5 s old and tick increasing).
GAMECITY_HEALTH_TIMEOUT=60
